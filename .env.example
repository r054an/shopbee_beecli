# ShopBee Configuration
# Copy to .env and fill in your values

# Bee API (auto-detected if bee login is set up)
BEE_API_BASE=https://app-api-developer.ce.bee.amazon.dev/
BEE_TOKEN=your_bearer_token_here

# Amazon Product Advertising API (optional, for richer product data)
AMAZON_PA_API_KEY=your_amazon_api_key
AMAZON_PA_API_SECRET=your_amazon_api_secret
AMAZON_ASSOC_TAG=your_associate_tag

# Amazon Shopping Actions
AMAZON_SHOPPING_ACTION_ENABLED=true
AMAZON_SHOPPING_DIRECTIVE_NAMESPACE=Alexa.Shopping
AMAZON_SHOPPING_DIRECTIVE_NAME=AddToShoppingCart
